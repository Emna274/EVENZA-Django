# Configuration locale Django. Générer une clé différente sur chaque poste.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_DB_PATH=db.sqlite3

